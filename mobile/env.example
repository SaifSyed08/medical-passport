# Copy to mobile/.env and set the Parity Workers API the app should talk to.
# Deployed HTTPS URL (no tunnel needed):
#   EXPO_PUBLIC_API_URL=https://<your-site-host>
# Or a local server on your Mac, reachable from your phone over the same Wi-Fi (use the Mac's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8787
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Interpreter tab: the Parity Interpreter server (interpreter/), over HTTPS so the phone's mic works.
# Run it with ACCESS_CODE set and put the same code here. The code ends up inside the app bundle: fine for this demo, not for production.
#   EXPO_PUBLIC_INTERPRETER_URL=https://<interpreter-tunnel>.trycloudflare.com
#   EXPO_PUBLIC_INTERPRETER_CODE=<same as the server's ACCESS_CODE>
EXPO_PUBLIC_INTERPRETER_URL=
EXPO_PUBLIC_INTERPRETER_CODE=

# Document reading: the extractor Worker (../extractor), which uses the local PaddleOCR server (../ocr). Empty = off.
EXPO_PUBLIC_EXTRACTOR_URL=
