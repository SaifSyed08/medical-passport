# Copy to mobile/.env and set the Tessera Workers API the app should talk to.
# Deployed HTTPS URL (no tunnel needed):
#   EXPO_PUBLIC_API_URL=https://<your-site-host>
# Or a local server on your Mac, reachable from your phone over the same Wi-Fi (use the Mac's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8787
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
